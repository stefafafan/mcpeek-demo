{
  "name": "mcpeek-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "pnpm wasm && vite --host 127.0.0.1",
    "build": "pnpm wasm && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "test": "go test ./wasm && pnpm wasm && playwright test",
    "test:browser": "pnpm wasm && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@uiw/react-codemirror": "^4.25.11",
    "lucide-react": "^1.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "4.129.1"
  }
}
